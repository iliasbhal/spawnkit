{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "module": "ESNext",
    "target": "ES2020",

    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
